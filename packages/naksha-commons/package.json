{
  "name": "@biodiv-platform/naksha-commons",
  "version": "5.0.0-beta.3",
  "type": "module",
  "author": "harshzalavadiya",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": "strandls/naksha-components-react",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "clean": "rm -rf node_modules dist .turbo",
    "build": "tsup src/index.tsx --format esm,cjs --dts --minify --external react",
    "dev": "tsup src/index.tsx --format esm,cjs --watch --dts --external react"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@biodiv-platform/eslint-preset": "workspace:*",
    "@biodiv-platform/tsconfig": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
