{
  "name": "@biodiv-platform/naksha-maplibre-view",
  "version": "5.0.6-beta.0",
  "type": "module",
  "author": "arun",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": "strandls/naksha-components-react",
  "files": [
    "dist/**",
    "locales/**"
  ],
  "scripts": {
    "clean": "rm -rf node_modules dist .turbo",
    "build": "tsup src/index.tsx --format esm,cjs --dts --minify --external react",
    "dev": "tsup src/index.tsx --format esm,cjs --watch --dts --external react"
  },
  "peerDependencies": {
    "maplibre-gl": ">=4.0.0",
    "react": ">=18.0.0",
    "react-map-gl": ">=7.0.0"
  },
  "devDependencies": {
    "@biodiv-platform/eslint-preset": "workspace:*",
    "@biodiv-platform/tsconfig": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "tsup": "^9.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@biodiv-platform/naksha-commons": "workspace:*",
    "@turf/bbox": "^7.4.0",
    "boundingbox": "^1.4.0"
  }
}
